includes:
    # Achados pré-existentes (relações/estáticos mágicos do Flarum) ficam
    # congelados aqui para a CI ficar verde e o código NOVO continuar sendo
    # cobrado no nível 6. Aperte o baseline com o tempo.
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - src
        - extend.php
    # A CI resolve flarum/core via `composer update`, então um achado
    # baselinado pode não reproduzir em toda célula. Não falhe quando uma
    # entrada congelada ficar sem uso.
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
