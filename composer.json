{
    "name": "ramon/backup",
    "description": "Full backups and one click migration for Flarum 2",
    "keywords": [
        "flarum",
        "backup",
        "export",
        "import",
        "migration"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ramon Guilherme",
            "email": "ramon@ramonguilherme.com.br",
            "homepage": "https://ramonguilherme.com.br",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3 <8.6",
        "flarum/core": "^2.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6",
        "roave/security-advisories": "dev-latest",
        "phpstan/phpstan": "^2.0",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Ramon\\Backup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ramon\\Backup\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "extra": {
        "flarum-extension": {
            "title": "Backup & Migration",
            "category": "feature",
            "icon": {
                "image": "icon.svg",
                "backgroundColor": "#fff",
                "color": "#fff"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
