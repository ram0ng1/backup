{
    "name": "ramon/backup",
    "version": "2.0.14",
    "description": "All-in-one backup, export and import for Flarum, with optional asymmetric encryption.",
    "keywords": [
        "flarum",
        "backup",
        "export",
        "import",
        "migration"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ramon Guilherme",
            "email": "ramon@ramonguilherme.com.br",
            "homepage": "https://ramonguilherme.com.br",
            "role": "Developer"
        }
    ],
    "require": {
        "flarum/core": "^2.0.0"
    },
    "autoload": {
        "psr-4": {
            "Ramon\\Backup\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Backup & Migration",
            "category": "feature",
            "icon": {
                "image": "icon.svg",
                "backgroundColor": "#fff",
                "color": "#fff"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
